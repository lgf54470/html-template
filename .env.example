[TEMPLATE]
# ============================================================
# 环境变量示例 — 复制为 .env 并按需修改
# 所有变量均可选;不设置时使用代码内默认值
# ============================================================

# HTTP 端口(默认 3000)
PORT=3000

# 首次启动时用于初始化管理员密码(scrypt 加盐哈希后入库)
# 不设置则首次启动自动生成并打印到控制台
# AUTH_PASSWORD=

# 数据库驱动:sqlite(默认,本地文件)/ turso(远程 Turso/libSQL)/ d1(Cloudflare D1)
DB_DRIVER=sqlite

# 本地 sqlite 文件路径(默认 sqlite.db,已 gitignore)
SQLITE_PATH=sqlite.db

# 敏感数据加密密钥(64 位 hex = 32 字节),用于 AES-256-GCM 加密:
# settings:profile(含邮箱)等敏感键值落库前加密,数据库不以明文存放
# 不设置则首次启动自动生成并保存到 server/.secret-key(仅本地开发;
# 生产环境务必显式设置,丢失/更换将导致已加密数据无法解密)
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- 仅 DB_DRIVER=turso 时必填 ----
# DATABASE_URL=https://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=xxxxxxxxxxxxxxxx

# ---- 仅 DB_DRIVER=d1(REST 模式,本地 Node 直连 D1)时必填;Worker 部署无需这些 ----
# D1_ACCOUNT_ID=<Cloudflare 账号 ID>
# D1_DATABASE_ID=<D1 数据库 ID(UUID)>
# D1_API_TOKEN=<API Token,权限:D1 Read / D1 Write>
# 完整 Cloudflare 部署说明见 DEPLOY.md
