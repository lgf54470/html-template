{
  "name": "html-template",
  "version": "1.0.0",
  "private": true,
  "description": "纯 HTML/JS/CSS 管理后台模板(静态 + Node 服务;零运行时依赖)",
  "scripts": {
    "build": "node scripts/vercel-build.js",
    "start": "node dev-server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js test/docs/*.test.js test/settings/*.test.js",
    "deploy": "wrangler deploy",
    "deploy:vercel": "vercel --prod",
    "deploy:deno": "deno deploy --prod",
    "deploy:docker": "docker compose up -d --build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0"
  }
}
